# Files listed here are ignored by Git: they stay on this PC and are never
# added to the repository.

# Video files are far too large for Git (one example is 5.3 GB).
*.mp4
*.MP4
*.mov
*.MOV

# External tools (ExifTool, ffmpeg) are copied here by hand. They are large and
# have their own licences, so the whole folder stays out of the repository.
executables/

# The example folder is kept out until it is decided which example is published.
# Remove this line to include its events file and GPX file.
example video  and output file/

# The author's own footage to run the module on, with its output files.
input video files/

# Files Python creates by itself when code runs.
__pycache__/

# The virtual environment holds the installed Python libraries (several GB).
.venv/
